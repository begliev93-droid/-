{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  }, {
    "mhModeHint": 0,
    "juJustifCode": 0,
    "sdScrollDir": 3
  } ],
  "wpWinPositions": [ {
  
  }, {
    "apPoint": 6,
    "ahHorPos": 20,
    "avVerPos": 100,
    "rcRows": 2,
    "ccCols": 40
  }, {
    "apPoint": 7,
    "ahHorPos": 50,
    "avVerPos": 100,
    "rcRows": 2,
    "ccCols": 40
  } ],
  "events": [ {
    "tStartMs": 0,
    "id": 1,
    "wpWinPosId": 2,
    "wsWinStyleId": 1
  }, {
    "tStartMs": 2680,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Калтанда смартфон бар."
    } ]
  }, {
    "tStartMs": 7120,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Брак монананда сатыбалалмайсын. Уиткуне\nмунда сенин акшан журмейди. Телефоном"
    } ]
  }, {
    "tStartMs": 13040,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ешкимге конграу шалалмайды. Алкешке\nкайда конатниндэ али билмейсин."
    } ]
  }, {
    "tStartMs": 18360,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Саган бир апта шыдау керек.\nЕн киын сынак. Кылышта. Согуста болмау"
    } ]
  }, {
    "tStartMs": 23800,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "мумкин. Баре бир жутым судан басталады.\nКозалдына он биринчи гасырдын басын"
    } ]
  }, {
    "tStartMs": 30720,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "елестед.\nОтырар. Тарихи деректерде Фарабат минди"
    } ]
  }, {
    "tStartMs": 35120,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "белгили саудагаласы. Биз шамамен мын\nжирма алтынчи жылды тандаймыз."
    } ]
  }, {
    "tStartMs": 40240,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бул нахты бир адамнын кунделиги емес.\nТарихи ортага курылган ойша тажирибе."
    } ]
  }, {
    "tStartMs": 46000,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Шарт карапайым. Устинде кунделикти\nкиимин бар. Озинмен бирге тек телефон"
    } ]
  }, {
    "tStartMs": 51080,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "келди. Дариде, арнайы куралда,\nжергиликти акшада жок. Максат. Жети"
    } ]
  }, {
    "tStartMs": 57000,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "куннен кейин тире. Аре оз кунинди коре\nала. Жагдайда калу. Сен болашакты"
    } ]
  }, {
    "tStartMs": 62280,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "билесин.\n\u003e\u003e [музыка]"
    } ]
  }, {
    "tStartMs": 63160,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Брак бул галанын бугинин билмейсин.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 67480,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Биринчи кун.\nСу."
    } ]
  }, {
    "tStartMs": 69760,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Тус ауа шолдей бастады. Кошеде су\nтасыган адамды коресин. Адет боынша"
    } ]
  }, {
    "tStartMs": 75040,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "телефонда шасын. Жахын жердеги дукенди\nиздемек боласын."
    } ]
  }, {
    "tStartMs": 79200,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Брак карта жуктелмейди. Бул жерде уялы\nбайланыс желиси жок."
    } ]
  }, {
    "tStartMs": 84280,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бурлыс сыртында су бар. Алайда судын бар\nболумен онын ишуге жарамды болу. Еки"
    } ]
  }, {
    "tStartMs": 90480,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "болек нарсе. Онын кайда келгенин, калай\nсакталганын билмейсин."
    } ]
  }, {
    "tStartMs": 95280,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Отырар оазисинде адамдар суды озендермен\nсуару арналараркулы пайдаланды. Каламен"
    } ]
  }, {
    "tStartMs": 101320,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "егиншилик сол жиелерге сиенди.\nДемек маселе откен заманда су мулде"
    } ]
  }, {
    "tStartMs": 106760,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "болмаганда емес. Маселе. Сен сол жиени\nтусинбейсин."
    } ]
  }, {
    "tStartMs": 111600,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Биздин окигада бир шебер. Сенин ишаранды\nтусинип оз ауласынан су береди. Бул"
    } ]
  }, {
    "tStartMs": 117520,
    "dDurationMs": 10852,
    "wWinId": 1,
    "segs": [ {
      "utf8": "бирне миндетти турде кездесетни куткару.\nШемис. Биздин киипкерге келеди."
    } ]
  }, {
    "tStartMs": 123212,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Куткар Адам Саган Умер Карай Салам Да"
    } ]
  }, {
    "tStartMs": 128412,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Екинши Ген\nНан"
    } ]
  }, {
    "tStartMs": 130852,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Базарга Келди Кеше Тек Кабырга Да Байха\nДа Еди Да"
    } ]
  }, {
    "tStartMs": 135452,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Сауда Журип Жаткан Куресин\nАдамдар [музыка] Тауарын Курсетеди"
    } ]
  }, {
    "tStartMs": 139172,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Багасын Келиседи\nЗаттарын Тасыды"
    } ]
  }, {
    "tStartMs": 141972,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Манда Колын Созып Телефон Да Шыгарасын\nТолем Жасауга Дагды Ланган"
    } ]
  }, {
    "tStartMs": 146721,
    "dDurationMs": 4091,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [музыка]\n\u003e\u003e Кыймыл",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 147492,
    "dDurationMs": 6440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бирак Монда Сенин Банк Шотын Жок Экранда\nГа Акшан Осы Базар [музыка] Да Акшага"
    } ]
  }, {
    "tStartMs": 152812,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Айнал Майды\nАрине Телефон Да Айырбас Тап Куруге"
    } ]
  }, {
    "tStartMs": 156372,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Болады Алайда Оны Ким Алады Не Ушин\nАлады Каншага Багалайды"
    } ]
  }, {
    "tStartMs": 161812,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Буган Дайын Жауап Жок\nМонда Тиин Да Сауда Да Бар Сенде Жок"
    } ]
  }, {
    "tStartMs": 167332,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Нарсе Жергиликти Акшанын Кунын Билю Жани\nУзинг Бегиге Келисим Жасау"
    } ]
  }, {
    "tStartMs": 172652,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Кешеги Шеберди Кайта Табасын\nОнын Жуктер Тасуга Кумектесу Сунасын"
    } ]
  }, {
    "tStartMs": 177732,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ол Саган Тамак Беруге Келиседи\nБул Биздин Окига Дагы Келисим"
    } ]
  }, {
    "tStartMs": 182612,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ортага Сырлык Туракты Тариф Емес Алгашкы\nНанында Болашактан Келген Билимин"
    } ]
  }, {
    "tStartMs": 187572,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Менимес\nБугинги Жумысын Мен Таптым"
    } ]
  }, {
    "tStartMs": 190572,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бирак Ертенги Жумысты Калай Келисесин\nБир Бирин Да Али Толык Тусинбейсиндер"
    } ]
  }, {
    "tStartMs": 197132,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ушинши Ген Тил\nСаган Таныс Тыбыстар Естилед"
    } ]
  }, {
    "tStartMs": 201372,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Кейбир Созди Шамалайсын\nБирак Бирден Еркин Суйлесип Кетеалмайсын"
    } ]
  }, {
    "tStartMs": 206172,
    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Казирги Казак Тилим Билю Мын Жыл бурын\nАр Адамнын Созин Тугил Тусинуге Кепилдик"
    } ]
  }, {
    "tStartMs": 211172,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бермейди\nСауда Жолдара Артурли Журтты Тогыстырган"
    } ]
  }, {
    "tStartMs": 215132,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ал Кимнин Кай Тилде Кандай Созбен\nСуйлейтине Жагдайга Байланысты"
    } ]
  }, {
    "tStartMs": 220012,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Сен Нан Сурауды Тусиндирдин Делик\nБирак Жумыс Уакытын Карзда Немесе"
    } ]
  }, {
    "tStartMs": 224672,
    "dDurationMs": 5940,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[музыка] Биреудин Руксатын Тусиндиру\nКыйынрак"
    } ]
  }, {
    "tStartMs": 227612,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Телефон Да Аудармага Сенгин Делик Алайда\nБайланыс Жок"
    } ]
  }, {
    "tStartMs": 231932,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ал Осы Ортага Кажет Тилмен Создер\nКурылга Да Алдынала Сахталмаган"
    } ]
  }, {
    "tStartMs": 236932,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Сондыктан Сен Ишарага\nКайталауга"
    } ]
  }, {
    "tStartMs": 239492,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Жани Ап"
    } ]
  }, {
    "tStartMs": 242774,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Сонда кто там 7",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 247374,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1 за 2"
    } ]
  }, {
    "tStartMs": 250974,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ер тем солнцем\nМаксатин"
    } ]
  }, {
    "tStartMs": 257174,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Берк Арапаим\n\u003e\u003e [музыка]"
    } ]
  }, {
    "tStartMs": 260654,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Кешке горой",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 264454,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Енда"
    } ]
  }, {
    "tStartMs": 270214,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Торт на щеке Колонна не горит\n7 электродинамики"
    } ]
  }, {
    "tStartMs": 275374,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ушаков Калашников сундерланд Микробы\nбармен доблести"
    } ]
  }, {
    "tStartMs": 280334,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Берса узим до Булгари на холода Адама\nсезну [музыка] мункин Брак щебень сазда"
    } ]
  }, {
    "tStartMs": 286294,
    "dDurationMs": 10600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "гусениц Один бурдей екада шаса курдит\nБерлин Кабардинка и сак Еканин колонна"
    } ]
  }, {
    "tStartMs": 293494,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "утра горит Да им за ты не еканин блюдо\nон уже сабли у эмис Уган материал Курал"
    } ]
  }, {
    "tStartMs": 299993,
    "dDurationMs": 9861,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[музыка] таджики Жанне Баско Адам Ларден\nегиптянин Алман щебень осман барин сине"
    } ]
  }, {
    "tStartMs": 306214,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "жакс Олса зинку инколом инсектицид\nКайзер де Аслан был майдан 7 азер"
    } ]
  }, {
    "tStartMs": 313334,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "его на клеммной кайдо бирюзовый Сон\nдактан Алга школа мусульман улькан жана"
    } ]
  }, {
    "tStartMs": 318294,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "лагашу был майд Эдо старда тасу жумус\nорна [музыка] джина таб сырма на муки от"
    } ]
  }, {
    "tStartMs": 323534,
    "dDurationMs": 10960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "орна да больному мункин Кешке 7 Азамат\nсапай да лабудин Брак пойду лабудин Если"
    } ]
  }, {
    "tStartMs": 331014,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "на голову бернард синус\nБесенчук Туннель тенжер"
    } ]
  }, {
    "tStartMs": 337054,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Кендис базарда Адам губ Кешке Артем уст\nруль огня тарайт 7 соусы с деганом"
    } ]
  }, {
    "tStartMs": 343054,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "мангуст сура кто сменит\nБугун хайес ты гагарин Халада и де аула"
    } ]
  }, {
    "tStartMs": 348614,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "да бар\nАрхеолог таро утра один 11 гастарбайтер"
    } ]
  }, {
    "tStartMs": 352334,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "тургуналиев ушахтар кутерьма ксаклер\nЖанне шаровары булектер тапка Бульдозер"
    } ]
  }, {
    "tStartMs": 358254,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "де Адам дар тур мусульман им достать\nтруп и джай лаган Брак при удивление 7"
    } ]
  }, {
    "tStartMs": 363334,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "щендай куна гинес Бизнес у кидаешь и\nберсерк аула"
    } ]
  }, {
    "tStartMs": 370775,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бир неше кун бойы"
    } ]
  }, {
    "tStartMs": 375455,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Енди Журисин баяулайт.\nКоркынышты ету ушин"
    } ]
  }, {
    "tStartMs": 380615,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Олим укимине\nКажетти жок. Усак жара Миндети турде"
    } ]
  }, {
    "tStartMs": 384895,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "улкен ауруга уласпайт. Бирак Сенин бурын\nсуйенген комегин Бул жерде дал сол"
    } ]
  }, {
    "tStartMs": 390615,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "куйинде жок. Калтаннан дари шыгара\nалмайсын. Казирги емханага бара"
    } ]
  }, {
    "tStartMs": 395255,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "алмайсын. Ол заманда Емшиде, медициналык\nбилимде болган. Алайда Оны бугингы"
    } ]
  }, {
    "tStartMs": 401255,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "диагностикамен Дари-дармекпен Жане\nколжетимди комекпен тенистируге болмайт."
    } ]
  }, {
    "tStartMs": 406695,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Биздин кейипкеримизге Бул жолы ауыр\nсыркат емес. Жумысын баяулататын"
    } ]
  }, {
    "tStartMs": 411335,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ауырсыну кездесет. Сен [музыка] аз жумыс\nистесен Тамагын мен конатын жерин туралы"
    } ]
  }, {
    "tStartMs": 416815,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "келисимге не болат? Мине Кауипти екинши\nжагы. Денсаулык тек денеге катысты емес."
    } ]
  }, {
    "tStartMs": 423335,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Ол табысына Тамагына Баска адамдардын\nкомегине де асери етед. Шебер Бугин"
    } ]
  }, {
    "tStartMs": 429055,
    "dDurationMs": 7834,
    "wWinId": 1,
    "segs": [ {
      "utf8": "женилрек ис беред. Сен онын неге осылай\nжасаганын телефоннан издемейсин. Алгашкы"
    } ]
  }, {
    "tStartMs": 434655,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "рет Жайгана алгыс айтуга тырысасын.\n[музыка]"
    } ]
  }, {
    "tStartMs": 438895,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Жеттинши кун. Сен али осындасын. Суды\nкайдан сурауды билесин. Базарга апаратын"
    } ]
  }, {
    "tStartMs": 445055,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "жолды танисын.\nБир неше созди тусинесин. Шеберханада"
    } ]
  }, {
    "tStartMs": 449255,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Кидиргис келтирмей комектесе аласын.\nСен бул каланы багындырган жоксын."
    } ]
  }, {
    "tStartMs": 453920,
    "dDurationMs": 5295,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [музыка]\n\u003e\u003e Тек онын тиршилигине кишкене косылдын.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 456815,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Телефон"
    } ]
  }, {
    "tStartMs": 469640,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [музыка]",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 490017,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Телефон им до кайта схаваться.\n\u003e\u003e [музыка]",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 492137,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Он им жарко меня камера с алида пойду на\nголову мунку.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 496057,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Брак он саган нам к сермить. И вермить.\nЖене сене очень сене мге и волны."
    } ]
  }, {
    "tStartMs": 502137,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Солнце здесь саган там дал уснул до\nдебила с тетей."
    } ]
  }, {
    "tStartMs": 505817,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Берзата алаласа. Замануха круглая на не\nмиссия у сахалина перш лиги на блитне"
    } ]
  }, {
    "tStartMs": 511377,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "серки. Бренд шигану сене круглая на там\nдармида. А у. Казер."
    } ]
  }, {
    "tStartMs": 518777,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бизнес у тебя да бряк тада нут.\nБулки из геля на дам менде ты туда у"
    } ]
  }, {
    "tStartMs": 523697,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "этот диген дали ли мисс.\nБереги саудовка жажда и га полу на"
    } ]
  }, {
    "tStartMs": 528217,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "кельвин и ски жене ким гежу лука на\nбайла на ста."
    } ]
  }, {
    "tStartMs": 532017,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Брак брнер сеанс болда. Сен жалко за у\nзин умер с ружа канжу."
    } ]
  }, {
    "tStartMs": 538617,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Бас на до сене була шак там геля на да\nми."
    } ]
  }, {
    "tStartMs": 541417,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Сон до там. Берен баска ладан жакса блем\nне де бойла."
    } ]
  }, {
    "tStartMs": 545337,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Автоном сон до баска на сене тусу.\nБизнес кун до лик до кабли там из ним"
    } ]
  }, {
    "tStartMs": 549937,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "бер бу лиги у зин мисс те. А у лику бу\nлиги айна лама с дага адам дар мен живи"
    } ]
  }, {
    "tStartMs": 555097,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ли лиги с юна. Кран дага су. Дукен деги\nнам. Снук до тиль. Дар геги аппарат на"
    } ]
  }, {
    "tStartMs": 561057,
    "dDurationMs": 8144,
    "wWinId": 1,
    "segs": [ {
      "utf8": "жол. Сен сене там на дам. Бла бер гун де\nпойду на болган жо. Ман даган адам ним"
    } ]
  }, {
    "tStartMs": 566897,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "гем беги бер берне жалган от тур.\n\u003e\u003e [музыка]"
    } ]
  }, {
    "tStartMs": 569297,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e У трада га сибир сене телефон им до\nжасай алмай. Брак сене де он им бер гун",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 574417,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "им кумек сис. Кай тала ял мау мунку.\nСон до там. Сура кте ман жил брун тири"
    } ]
  }, {
    "tStartMs": 579897,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "галар ма е дин и мисс. [музыка]\nСен бугун. У мир с ружья гана лим ним"
    } ]
  }, {
    "tStartMs": 583697,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "канча бу лиги с ними у зин жасай ала.\nА у вот кинге брега на кабли там да у"
    } ]
  }, {
    "tStartMs": 588777,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "лип кит сене кай син там да ре.\nА у вот кинге брега на кабли там да у"
    } ]
  }, {
    "tStartMs": 594057,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "лип кит сене. Кай син там да ре."
    } ]
  } ]
}
